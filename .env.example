# Where the team does its thinking.
#   omniroute (default): a local OmniRoute gateway. Start it with `omniroute`, connect providers at http://localhost:20128
#   anthropic: the Anthropic API (needs ANTHROPIC_API_KEY below)
AI_BACKEND=omniroute
OMNIROUTE_URL=http://localhost:20128/v1
# Only needed if your OmniRoute requires a key: copy it from the OmniRoute dashboard, Endpoints page.
OMNIROUTE_API_KEY=

# For AI_BACKEND=anthropic
ANTHROPIC_API_KEY=

# Model used by anyone you have not given their own model in the game (OmniRoute: "auto" picks the best available route)
# CITY_MODEL=auto
